# Copy to .env and fill in. .env is gitignored.

# --- Google Maps -------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials.
# Enable "Maps SDK for Android" / "Maps SDK for iOS" and restrict each key to
# the matching platform and bundle id (com.tripcompanion.app).
#
# The Android key must ALSO be restricted to the SHA-1 of whichever keystore
# signed the build. A key restricted to the debug SHA-1 renders a blank grey
# map in release builds. Print the release SHA-1 with:
#   keytool -list -v -keystore android/app/release.keystore -alias upload
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# --- Firebase (Auth + Firestore) ---------------------------------------------
# Firebase Console → Project settings → Your apps → Web app config.
# These EXPO_PUBLIC_ values are embedded in the client bundle (expected for
# Firebase web config). Protect data with Firestore security rules, not by
# hiding the keys. Enable Email/Password under Authentication → Sign-in method.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Builder web app (Next.js) uses the same Firebase project with NEXT_PUBLIC_ names.
# Copy the same values when running `builder/` locally or in CI.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Android release signing -------------------------------------------------
# Read by android/app/signing.gradle. Path is relative to android/app/.
# Back up the keystore and these passwords somewhere durable: losing them means
# you can never publish an update to the same store listing.
TRIPENERARY_UPLOAD_STORE_FILE=release.keystore
TRIPENERARY_UPLOAD_STORE_PASSWORD=
TRIPENERARY_UPLOAD_KEY_ALIAS=upload
TRIPENERARY_UPLOAD_KEY_PASSWORD=
