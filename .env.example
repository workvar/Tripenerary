# Mobile app (Expo / Android) — copy to .env in the repo root.
# .env is gitignored. Do not put builder (NEXT_PUBLIC_*) vars here;
# those live in builder/.env.example → builder/.env.local (and Vercel).

# --- Google Maps -------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials.
# Enable "Maps SDK for Android" / "Maps SDK for iOS" and restrict each key to
# package / bundle id com.tripcompanion.app.
#
# The Android key must ALSO be restricted to the SHA-1 of every keystore that
# signs a build users will run:
#   - debug.keystore (local)
#   - release/upload keystore (bundleRelease)
#   - Play App Signing key (Play Console → Setup → App signing)
# A key restricted only to the debug SHA-1 renders a blank grey map in release
# and on Play installs. Print the upload SHA-1 with:
#   keytool -list -v -keystore android/app/release.keystore -alias upload
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# --- Firebase (Auth + Firestore) ---------------------------------------------
# Firebase Console → Project settings → Your apps → Web app config.
# EXPO_PUBLIC_* values are embedded in the client bundle (expected for Firebase
# web config). Protect data with firestore.rules / storage.rules, not by hiding
# these. Enable Email/Password under Authentication → Sign-in method.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Android release / Play upload signing (local builds) --------------------
# Read by android/app/signing.gradle. Path is relative to android/app/.
# This is the Play *upload* key. Play App Signing re-signs what users install.
# Back up the keystore and these passwords somewhere durable: losing them means
# you can never publish an update without a Play Console upload-key reset.
TRIPENERARY_UPLOAD_STORE_FILE=release.keystore
TRIPENERARY_UPLOAD_STORE_PASSWORD=
TRIPENERARY_UPLOAD_KEY_ALIAS=upload
TRIPENERARY_UPLOAD_KEY_PASSWORD=

# =============================================================================
# GitHub Actions (repo Settings → Secrets and variables) — not used in .env
# =============================================================================
# Secrets:
#   ANDROID_KEYSTORE_BASE64              base64 -w0 android/app/release.keystore
#   TRIPENERARY_UPLOAD_STORE_PASSWORD
#   TRIPENERARY_UPLOAD_KEY_ALIAS
#   TRIPENERARY_UPLOAD_KEY_PASSWORD
#   GOOGLE_MAPS_ANDROID_KEY
#   GOOGLE_PLAY_SERVICE_ACCOUNT_JSON     full Play Console service-account JSON
#   EXPO_PUBLIC_FIREBASE_API_KEY
#   EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN
#   EXPO_PUBLIC_FIREBASE_PROJECT_ID
#   EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET
#   EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   EXPO_PUBLIC_FIREBASE_APP_ID
#
# Variables:
#   PLAY_STORE_ENABLED                   true to upload AAB on v* tags
#   PLAY_STORE_TRACK                     optional: internal | alpha | beta | production
