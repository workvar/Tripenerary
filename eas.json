{
  "cli": { "version": ">= 5.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "NODE_ENV": "production" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": { "NODE_ENV": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
