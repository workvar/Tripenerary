<resources>
  <!-- Android 12+ draws the splash itself: a solid window colour with the icon
       masked into a 192dp circle inside a 288dp canvas. Handing it the launcher
       icon (a full-bleed square) is what got it cropped, so it gets a dedicated
       drawable whose artwork already sits inside the content circle. -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="android:windowSplashScreenAnimationDuration">400</item>
  </style>
</resources>
