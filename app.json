{
  "expo": {
    "name": "Tripenerary",
    "slug": "trip-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "tripcompanion",
    "splash": {
      "backgroundColor": "#0E4F4C",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.tripcompanion.app",
      "versionCode": 1,
      "adaptiveIcon": { "backgroundColor": "#0E4F4C" },
      "config": {
        "googleMaps": { "apiKey": "REPLACE_WITH_ANDROID_MAPS_API_KEY" }
      }
    },
    "ios": {
      "bundleIdentifier": "com.tripcompanion.app",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "REPLACE_WITH_IOS_MAPS_API_KEY"
      }
    },
    "extra": {
      "eas": { "projectId": "" }
    }
  }
}
