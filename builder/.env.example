# Builder webapp (Next.js) — copy to builder/.env.local
# Next.js loads .env.local automatically. Do not put mobile EXPO_PUBLIC_* or
# Android signing vars here; those live in the repo-root .env.example.

# --- Firebase (Auth + Firestore + Storage + Analytics) -----------------------
# Same Firebase project as the mobile app. Use the Web app config from
# Firebase Console → Project settings. Enable Google and Email/Password sign-in
# providers, Firestore, and Storage; deploy ../firestore.rules and
# ../storage.rules. Under Authentication → Settings → Authorized domains, add
# localhost and every host that serves the builder (e.g. your Vercel domain).
#
# NEXT_PUBLIC_* values are embedded in the client bundle. Sessions persist in
# the browser via Firebase local persistence. Cloud save is capped at 20 MB;
# Publish link writes a public JSON URL for the mobile Add-trip sheet.
# measurementId (G-…) enables Google Analytics when present.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# Vercel (Project → Settings → Environment Variables)
# =============================================================================
# Add the same seven NEXT_PUBLIC_FIREBASE_* names for Production / Preview /
# Development as needed. No other secrets are required for the builder today.
#
# GitHub Actions does not deploy the builder; the release workflow only
# typechecks it.
